# 复制为 .env 后按实际环境修改：
#   cp .env.example .env

# 宿主机上本仓库与数据的根目录
PXE_ROOT=/var/pxe

# PXE 通告地址（HTTP/TFTP 来源，也是 DHCP next-server）
# 用 scripts/setup-pxe-ip.sh 在某张物理网卡上追加这个次地址
PXE_IP=192.168.0.1

# dnsmasq 绑定的网卡。
#   auto = 按 PXE_IP 自动反查承载它的网卡（推荐，省得写死网卡名）
#   也可显式写死，如 bond0 / ens33 / enp51s0f0
PXE_INTERFACE=auto

# DHCP 模式（没有"关闭 DHCP"选项，二选一）：
#   proxy = proxyDHCP：只应答 PXE 引导文件名、不分配地址，与网段现有 DHCP 共存（通用，不确定时选它）
#   full  = 本机分配地址 + 下发引导；仅当该网段没有任何其它 DHCP 时使用
# 网段已有 DHCP 还用 full，会导致客户端 PXE-E53。
DHCP_MODE=proxy

# 引导固件：决定给客户端下发哪种引导文件
#   uefi = 只发 UEFI（默认，生产全 UEFI；BIOS 客户端拿不到引导，杜绝误装 legacy 脚本）
#   both = BIOS(arch 0) 与 UEFI(arch 7/9) 按客户端固件自动分流，无先后优先级（兼容两种机器）
#   bios = 只发 BIOS（任何客户端都走 pxelinux.0）
PXE_FIRMWARE=uefi

# full 模式地址池。192.168.0.0/23 → 192.168.0.0–192.168.1.255，掩码 255.255.254.0
# 不要包含 PXE_IP（192.168.0.1）。proxy 模式下地址池被忽略，但仍需填（用于算网段）。
DHCP_RANGE_START=192.168.0.10
DHCP_RANGE_END=192.168.1.200
DHCP_NETMASK=255.255.254.0
DHCP_LEASE=12h

# 可选：下发给客户端的网关和 DNS。留空则不下发这两项
PXE_GATEWAY=
PXE_DNS=

# 镜像：留空 = 自动遍历 /var/pxe/http/iso/ 下所有 *.iso，每个生成一个菜单项（多镜像）
# 也可只装一个时指定文件名，只处理这一个
ISO_FILENAME=

# PXE HTTP 端口（80 被占用时用 8080）
HTTP_PORT=8080
